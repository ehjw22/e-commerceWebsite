generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model diningFeedback {
  feedbackId  Int        @id @default(autoincrement()) @map("feedback_id")
  productId   Int        @map("product_id")
  memberId    Int        @map("member_id")
  comments    String
  ratings     Int
  lastUpdated DateTime?  @map("last_updated") @db.Timestamp(6)
  member      member     @relation(fields: [memberId], references: [memberId], onDelete: Cascade, onUpdate: NoAction)
  product     product    @relation(fields: [productId], references: [productId], onDelete: Cascade, onUpdate: NoAction)
  feedback    feedback[]

  @@map("dining_feedback")
}

model feedback {
  diningFeedbackId Int            @map("dining_feedback_id")
  memberId         Int            @map("member_id")
  feedbackId       Int            @id @default(autoincrement()) @map("feedback_id")
  comments         String
  diningFeedback   diningFeedback @relation(fields: [diningFeedbackId], references: [feedbackId], onDelete: Cascade, onUpdate: NoAction)
  member           member         @relation(fields: [memberId], references: [memberId], onDelete: Cascade, onUpdate: NoAction)
}

model member {
  memberId       Int              @id @default(autoincrement()) @map("member_id")
  username       String           @unique @db.VarChar(50)
  email          String           @unique @db.VarChar(100)
  passwordHash   String           @map("password_hash") @db.VarChar(255)
  firstName      String           @map("first_name") @db.VarChar(50)
  lastName       String           @map("last_name") @db.VarChar(50)
  createdAt      DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  diningFeedback diningFeedback[]
  feedback       feedback[]
  memberRole     memberRole[]
  saleOrder      saleOrder[]
  cart           cart[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model memberRole {
  memberId Int    @map("member_id")
  role     String @db.VarChar(20)
  member   member @relation(fields: [memberId], references: [memberId], onDelete: NoAction, onUpdate: NoAction)

  @@id([memberId, role])
  @@map("member_role")
}

model product {
  productId      Int              @id @default(autoincrement()) @map("product_id")
  name           String           @db.VarChar(100)
  description    String?
  price          Decimal          @db.Decimal(10, 2)
  category       String?          @db.VarChar(50)
  isAvailable    Boolean?         @default(true) @map("is_available")
  createdAt      DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  diningFeedback diningFeedback[]
  saleOrderItem  saleOrderItem[]
  cartItem       cartItem[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model saleOrder {
  orderId         Int             @id @default(autoincrement()) @map("order_id")
  memberId        Int?            @map("member_id")
  orderDate       DateTime?       @default(now()) @map("order_date") @db.Timestamp(6)
  totalAmount     Decimal         @map("total_amount") @db.Decimal(10, 2)
  status          String          @db.VarChar(20)
  deliveryAddress String?         @map("delivery_address")
  member          member?         @relation(fields: [memberId], references: [memberId], onDelete: NoAction, onUpdate: NoAction)
  saleOrderItem   saleOrderItem[]

  @@map("sale_order")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model saleOrderItem {
  orderItemId Int        @id @default(autoincrement()) @map("order_item_id")
  orderId     Int?       @map("order_id")
  productId   Int?       @map("product_id")
  quantity    Int
  unitPrice   Decimal    @map("unit_price") @db.Decimal(10, 2)
  subtotal    Decimal    @db.Decimal(10, 2)
  saleOrder   saleOrder? @relation(fields: [orderId], references: [orderId], onDelete: NoAction, onUpdate: NoAction)
  product     product?   @relation(fields: [productId], references: [productId], onDelete: NoAction, onUpdate: NoAction)

  @@map("sale_order_item")
}

model cart {
  cartId       Int            @id @default(autoincrement()) @map("cart_id")
  memberId     Int            @unique @map("member_id")
  createdAt    DateTime?      @default(now()) @map("created_at") @db.Timestamp(6)
  member       member         @relation(fields: [memberId], references: [memberId], onDelete: Cascade, onUpdate: NoAction)
  cartDiscount cartDiscount[]
  cartItem     cartItem[]

  @@map("cart")
}

model cartItem {
  cartItemId Int     @id @default(autoincrement()) @map("cart_item_id")
  cartId     Int     @map("cart_id")
  productId  Int     @map("product_id")
  quantity   Int
  cart       cart    @relation(fields: [cartId], references: [cartId], onDelete: Cascade, onUpdate: NoAction)
  product    product @relation(fields: [productId], references: [productId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cartId, productId])
  @@map("cart_item")
}

model discount {
  discountId      Int            @id @default(autoincrement()) @map("discount_id")
  name            String         @db.VarChar(100)
  description     String?
  discountType    String         @map("discount_type") @db.VarChar(50) // one of the following values: "PRODUCT_QUANTITY", "CART_TOTAL", "DELIVERY"
  minTrigger      Decimal        @map("min_trigger") @db.Decimal(10, 2)// can be used for all three
  maxTrigger      Decimal?       @map("max_trigger") @db.Decimal(10, 2)
  value           Decimal        @db.Decimal(10, 2)
  targetProductId Int?           @map("target_product_id") // for product_quantity
  isActive        Boolean?       @default(true) @map("is_active")
  cartDiscount    cartDiscount[]
}

model cartDiscount {
  cartId     Int      @map("cart_id")
  discountId Int      @map("discount_id")
  cart       cart     @relation(fields: [cartId], references: [cartId], onDelete: Cascade, onUpdate: NoAction)
  discount   discount @relation(fields: [discountId], references: [discountId], onDelete: Cascade, onUpdate: NoAction)

  @@id([cartId, discountId])
  @@map("cart_discount")
}